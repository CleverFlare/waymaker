{
  "name": "waymaker",
  "private": true,
  "version": "0.0.0",
  "description": "Waymaker 3D scene editor",
  "author": {
    "name": "Muhammad Maher",
    "email": "blastclever@gmail.com"
  },
  "homepage": ".",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.waymaker.app",
    "productName": "Waymaker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    }
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@headless-tree/core": "^1.7.0",
    "@tailwindcss/vite": "^4.3.2",
    "@threlte/core": "^8.5.16",
    "@threlte/extras": "^9.21.0",
    "bits-ui": "^2.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-svelte": "^1.0.1",
    "mitt": "^3.0.1",
    "svelte": "^5.56.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^24.13.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "shadcn-svelte": "^1.4.2",
    "svelte-check": "^4.7.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0"
  }
}
